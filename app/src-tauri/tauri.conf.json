{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Larafim",
  "version": "0.1.4",
  "identifier": "dev.larafim.app",
  "build": {
    "beforeDevCommand": "cargo build -p larafim-shim && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../scripts/i18n.mjs sync && cargo build -p larafim-shim --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "resources": {
      "../../target/release/larafim-shim.exe": "larafim-shim.exe"
    },
    "shortDescription": "PHP, Node e bancos locais para seus projetos",
    "publisher": "Larafim"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMTE4NDA5QzE3OTEyMDMKUldRREVubkJDWVFSYTV5Qm45OHdaQnl4V2hnWXZ2elZPMmZBSEFiemVBekRnWGRydi9nK1lYSGEK",
      "endpoints": [
        "https://github.com/josevictoremiliano/larafim/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
