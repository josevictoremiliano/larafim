<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX da Microsoft Store. scripts/msix.ps1 troca
  {VERSION} pela versão do tauri.conf.json (X.Y.Z.0).
  Identity e PublisherDisplayName vêm do Partner Center
  (Gerenciamento de produtos › Identidade do produto).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop6 rescap">

  <Identity
    Name="jotav.larafim"
    Publisher="CN=FDB192AA-C755-4476-8A4C-DE058D7D5C5C"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Larafim</DisplayName>
    <PublisherDisplayName>jotav</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Runtimes em %LOCALAPPDATA%\Larafim e o PATH do usuário precisam ser
         os de verdade: o terminal (fora do pacote) usa os dois. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Larafim" Executable="larafim-app.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Larafim"
        Description="PHP, Node e bancos locais para seus projetos"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Caminho fixo para abrir o Larafim de fora (iniciar com o Windows,
             ajudante elevado do hosts): src-tauri/src/packaged.rs. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="larafim-app.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="larafim.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Exigida pelas duas linhas desktop6 acima. -->
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- Gravar o bloco do Larafim no arquivo hosts (UAC). -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
